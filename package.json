{
  "name": "voidnote-sdk",
  "version": "0.5.0",
  "description": "Official SDK for VoidNote — zero-knowledge self-destructing notes (no account needed) and live encrypted streams",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "tsc && node --test test/sdk.test.mjs"
  },
  "keywords": [
    "voidnote",
    "secrets",
    "encryption",
    "zero-knowledge",
    "self-destructing"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/quantum-encoding/voidnote-js"
  },
  "homepage": "https://voidnote.net",
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  }
